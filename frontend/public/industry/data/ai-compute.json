  "industry": {
    "id": "ai-compute",
    "name": "AI算力",
    "demand": "运行模型训练和推理任务",
    "boundary": "以GPU服务器到集群运行的典型架构为边界；不展开芯片制造全链、所有技术路线和机房工程。供应商产品只作角色样例，不代表市场份额。",
    "summary": "计算部件与服务器构成计算节点，网络、存储和软件组织协作，机房及供电散热支持训练与推理持续运行。",
    "basis": "editorial_scope_and_grouping"
  },
  "structure": {
    "version": 1,
    "organization": "composition",
    "thesis": "计算部件组成服务器，服务器提供集群的计算节点；网络、存储、软件与供电散热协同，使集群能承载训练和推理，而不是把所有配套串成加工步骤。",
    "groups": [
      {
        "id": "hardware",
        "title": "计算硬件",
