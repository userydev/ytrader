        "node_ids": [
          "accelerator",
          "server"
        ]
      },
      {
        "id": "operation",
        "title": "集群协同运行",
        "role": "core",
        "purpose": "让多台计算节点与数据、网络及调度协同工作，形成可运行的算力系统。",
        "node_ids": [
          "cluster"
        ]
      },
      {
        "id": "tasks",
        "title": "训练与推理用途",
        "role": "core",
        "purpose": "使用集群算力完成模型训练和推理，说明硬件与系统最终服务什么需求。",
        "node_ids": [
          "workload"
        ]
      },
      {
        "id": "coordination",
        "title": "通信、数据与调度",
        "role": "support",
        "purpose": "网络交换数据、存储持续供数、软件分配任务，分别解决集群协作所需的不同条件。",
        "node_ids": [
          "network",
          "storage",
          "software"
        ]
      },
      {
        "id": "facilities",
        "title": "供电与散热条件",
        "role": "support",
        "purpose": "为运行设备持续供电并排出热量，使集群具备部署和稳定工作的环境。",
        "node_ids": [
          "power",
          "cooling"
        ]
      }
    ],
