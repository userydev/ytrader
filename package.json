{
  "name": "ytrader", "version": "0.1.0", "private": true, "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite --host 127.0.0.1", "dev:api": "tsx watch server/main.ts",
    "build": "tsc --noEmit && vite build", "typecheck": "tsc --noEmit",
    "start": "tsx server/main.ts", "migrate": "tsx server/cli.ts migrate",
    "bootstrap-user": "tsx server/cli.ts bootstrap-user", "sync": "tsx server/cli.ts sync",
    "analyze": "tsx server/cli.ts analyze", "worker": "tsx server/cli.ts worker",
    "editorial": "tsx server/content/editorial-cli.ts",
    "test:editorial": "tsx --test tests/editorial.test.ts",
    "lint:forbidden": "tsx scripts/ci-forbidden-scan.ts",
    "test": "tsx scripts/ci-forbidden-scan.ts && tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@capacitor/browser": "8.0.0", "@aparajita/capacitor-secure-storage": "8.0.1", "@capacitor/core": "8.5.3", "@capacitor/ios": "8.5.3", "@fastify/cookie": "^11.0.2",
    "fastify": "^5.6.1", "pg": "^8.16.3", "react": "^19.1.1", "react-dom": "^19.1.1", "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3", "@types/node": "^22.18.0", "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13", "@types/react-dom": "^19.1.9", "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.5", "typescript": "^5.9.2", "vite": "^7.1.7"
  }
}
