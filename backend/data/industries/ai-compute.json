  "version": "2026-10-18.3",
  "origin": "public_reference",
  "explanation": {
    "overview": "AI算力要解决的是：让计算设备协同完成模型训练和推理。GPU提供计算能力，服务器把计算部件组织起来；当任务需要多台服务器时，网络负责交换数据，存储负责持续供数，软件负责分配和运行任务。供电与散热让这些设备能稳定工作。因此，看算力产业既要看计算产品，也要看通信、数据访问和机房配套。",
    "steps": [
      {
        "title": "计算部件组成服务器",
        "text": "GPU是这类AI服务器的计算部件。服务器是可部署的系统，不是GPU的下一道加工材料。",
        "node_ids": [
          "accelerator",
          "server"
        ],
        "sources": [
          "nv-architecture"
        ]
      },
      {
        "title": "多个系统共同支撑集群",
        "text": "服务器提供计算节点，网络连接节点，存储提供数据，软件管理资源。这些是协作关系；某项配套不足时，单独增加GPU不能保证任务按比例加快。",
        "node_ids": [
          "server",
          "network",
          "storage",
          "software",
          "cluster"
        ],
        "sources": [
          "nv-architecture"
        ]
      },
      {
        "title": "基础设施支撑实际运行",
        "text": "供电与散热属于部署条件。它们不作为模型的计算输入，却影响设备能否持续运行。最终集群服务训练和推理任务。",
        "node_ids": [
          "power",
          "cooling",
          "cluster",
          "workload"
        ],
        "sources": [
          "nv-facility",
          "nv-architecture"
        ]
      }
    ],
    "distinctions": [
      {
        "title": "组成与支撑要分开",
        "text": "GPU组成服务器；散热支撑集群运行。两者都重要，但关系含义不同。",
        "sources": [
          "nv-architecture",
          "nv-facility"
        ]
      },
      {
        "title": "公司可以跨多个位置",
        "text": "同一供应商可以同时提供硬件和管理软件。产业位置由具体产品确定，不用一个概念标签代替。",
        "sources": [
          "ieit",
          "nv-architecture"
        ]
      }
    ],
    "questions": [
      "GPU、网络、存储分别解决什么问题？",
      "为什么不能只用GPU数量解释一套算力系统？",
      "芯片制造、光模块和液冷还能怎样展开？"
    ],
    "gaps": [
      "当前主干从计算部件到集群运行；芯片设计、晶圆制造、封装、内存和光互连的细分尚未展开。",
      "未收录所有技术路线和参与公司；具体客户关系、订单和业务占比属于进一步研究。"
    ]
  }
}
